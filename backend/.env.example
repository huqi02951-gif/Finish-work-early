# SERVER PORT
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# JWT Auth
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
ENABLE_DEMO_AUTH="false"
SEED_ADMIN_PASSWORD="replace-with-a-strong-seed-password"

# DATABASE_URL for Prisma connection
# Connection structure: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
# If your password contains '@', encode it as '%40'.
DATABASE_URL="postgresql://db_user:db_password@127.0.0.1:5432/finish_work_early?schema=public"

# Supabase Auth bridge
# Used to validate Supabase email OTP sessions before issuing an APEX JWT.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# ─── Email (nodemailer SMTP) ───
# 生产环境必须配置 SMTP；仅非生产环境允许控制台预览验证码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@qq.com
SMTP_PASS=your-smtp-password
