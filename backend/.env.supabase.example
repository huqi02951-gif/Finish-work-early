# SERVER PORT
PORT=3000

# JWT Auth
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
ENABLE_DEMO_AUTH="true"
SEED_ADMIN_PASSWORD="replace-with-a-strong-seed-password"

# Supabase Postgres for Prisma
# Use Dashboard -> Connect -> Session pooler.
# Replace [YOUR-DB-PASSWORD] and [REGION]; do not commit real passwords.
DATABASE_URL="postgresql://postgres.oibwkknjgtkyxntyuybb:[YOUR-DB-PASSWORD]@aws-[REGION].pooler.supabase.com:5432/postgres?schema=public"

# Supabase Auth bridge
SUPABASE_URL="https://oibwkknjgtkyxntyuybb.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Email (nodemailer SMTP)
# Configure these for real email verification. Without SMTP, codes print in backend logs.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@qq.com
SMTP_PASS=your-smtp-password
